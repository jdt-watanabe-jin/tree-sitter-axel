{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "axel",
      "camelcase": "Axel",
      "scope": "source.axel",
      "file-types": [
        "axel",
        "axl",
        "h",
        "hh"
      ],
      "injection-regex": "^axel$",
      "class-name": "TreeSitterAxel"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Axel grammar for tree-sitter",
    "authors": [
      {
        "name": "JinWatanabe",
        "email": "watanabe.jin@jedat.co.jp"
      }
    ],
    "links": {
      "repository": "file://\\\\dvanakin\\repositories\\watanabe\\tree-sitter-axel.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}